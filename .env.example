# Frontend build-time env vars (Vite reads anything VITE_* and inlines into
# the bundle).
#
# Leave empty to call the API on the same origin (production on Vercel where
# /api/* is served from the same domain as the static frontend).
#
# For local dev against a backend on http://localhost:8000:
#   VITE_API_URL=http://localhost:8000
VITE_API_URL=
